---
import '../styles.css';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

const {title} = Astro.props;
---


<!DOCTYPE html>
<html lang="es" class="overflow-y-scroll">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="FCI" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Fundación Ciudadanía Inteligente - {title}</title>
    <ClientRouter />
  </head>
  <body>
    <div id="navbar">
      <Navbar />
    </div>
    <div class="container">
      <slot />
      <Footer />
    </div>
  </body>
</html>

<script>
  import Alpine from 'alpinejs';

  // Initialize Alpine on the initial page load
  Alpine.start();

  document.addEventListener('astro:page-load', () => {
    // Stop Alpine's observation to prevent issues during DOM manipulation
    Alpine.stopObservingMutations();

    // Dispatch 'alpine:init' to re-trigger Alpine's initialization process
    document.dispatchEvent(new Event('alpine:init'));

    // Initialize Alpine on the new DOM tree
    Alpine.initTree(document.documentElement);

    // Restart Alpine's observation for dynamic DOM changes
    Alpine.startObservingMutations();
  });
</script>
