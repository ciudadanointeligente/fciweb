---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import PublicacionCard from '../components/PublicacionCard.astro';
import { Image } from 'astro:assets';

const allpublicaciones = await getCollection('publicaciones')
---


<Layout title="Publicaciones">
    
    <!-- header -->
    <div class="bg-azul h-[300px] mix-blend-screen relative z-0 mt-[-30px] shadow-lg shadow-azul/45">
      <div class="text-center align-middle py-[120px]">
        <h1 class="text-4xl text-white font-extrabold">Publicaciones</h1>
      </div>
    </div>

  <main class="mx-auto text-center md:py-8 w-10/12 p-4 md:px-8 md:mt-12">
    <section aria-labelledby="proyectos-heading">
      {
      allpublicaciones.map((publicacion) => (
      <PublicacionCard 
        imagen={publicacion.data.imagen} 
        nombre={publicacion.data.nombre}
        descripcion={publicacion.data.descripcion}
        link={publicacion.data.link}
        descarga={publicacion.data.descarga}
      />
      ))
      }
    </section>

  </main>
</Layout>
