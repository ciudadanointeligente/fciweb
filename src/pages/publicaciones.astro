---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import PublicacionCard from '../components/PublicacionCard.astro';
import { Image } from 'astro:assets';
import HeroImage from '../assets/images/web/fci-hero-home.png';
import NewsletterForm from '../components/NewsletterForm.astro';

const allpublicaciones = await getCollection('publicaciones')
---


<Layout title="Publicaciones">

  <!-- header -->
  <div class="bg-azul h-[150px] md:h-[300px] mix-blend-screen relative z-0 mt-[-30px] shadow-lg shadow-azul/45">
    <div class="text-center align-middle py-10 md:py-[120px]">
      <h1 class="text-2xl md:text-4xl text-white font-extrabold">Publicaciones</h1>
    </div>
  </div>

  <!-- cards de publicaciones -->
  <main class="mx-auto text-center md:py-8 w-10/12 p-4 md:px-8 md:mt-12">
    <section aria-labelledby="proyectos-heading">
      {
      allpublicaciones.map((publicacion) => (
      <PublicacionCard 
        imagen={publicacion.data.imagen} 
        nombre={publicacion.data.nombre}
        descripcion={publicacion.data.descripcion}
        link={publicacion.data.link}
        descarga={publicacion.data.descarga}
      />
      ))
      }
    </section>

  </main>

    <!-- franja newsletter -->
    <NewsletterForm />

  <!-- hero footer -->
  <div class="flex md:mt-20 justify-center mb-8 mask-b-from-70%">
    <Image src={HeroImage} 
      alt="Fundación Ciudadanía Inteligente" 
      class="w-full h-[300px] md:h-[800px] object-cover image-fade-in transition ease-in-out duration-1000 delay-150" />
  </div>

</Layout>
