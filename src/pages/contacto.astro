---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import BocinaImage from '../assets/images/web/fci-megafono.png';
import HeroContacto from '../assets/images/web/fci-hero-home.png';
import BocinaImage2 from '../assets/images/web/fci-megafono-2.png';
import Boton from '../components/Boton.astro';
---


<Layout title="Contacto">

  <!-- header -->
  <div class="bg-azul h-[150px] md:h-[300px] mix-blend-screen relative z-0 mt-[-30px] shadow-lg shadow-azul/45">
    <div class="text-center align-middle py-10 md:py-[120px]">
      <h1 class="text-2xl md:text-4xl text-white font-extrabold">Contacto</h1>
    </div>
  </div>

  <main>
    <!-- título principal -->
    <div class="mt-10 md:mt-30 text-base md:text-lg items-center justify-center px-4">
      <p class="font-bold text-center text-2xl md:text-[32px] text-rosa">¿Quieres sumarte, colaborar </p>
      <p class="font-bold text-center text-2xl md:text-[32px] text-rosa">o escribirnos?</p> 
    </div>

    <!-- voluntariados y pasantías -->
    <div class="overflow-x-hidden">
      <div class="flex flex-row items-center">
        <div class="w-1/3 -ml-4 md:-ml-8 hidden md:flex items-center justify-start">
          <Image src={BocinaImage} 
            alt="Megáfono Fundación Ciudadanía Inteligente" 
            class="w-48 md:w-[317px] h-auto ml-0"/>
        </div>
        <div class="w-full md:w-2/3 self-start flex flex-col items-center justify-center md:px-40 py-4 px-4">
          <p class="font-normal text-center text-lg md:text-[22px] text-stone-800">Aquí están las formas de tomar contacto con Ciudadanía Inteligente:</p> 
          <p class="font-bold text-center text-xl md:text-[22px] text-azul pt-4">VOLUNTARIADO Y PASANTÍAS</p>
          <p class="font-normal text-center text-base md:text-[22px] text-stone-800">Se parte de nuestro equipo y aporta a la transformación democrática desde adentro</p>
          <p></p>
          <Boton href="mailto:info@ciudadaniai.org">POSTULA AQUÍ</Boton>
        </div>
        <div class="w-1/3 -mr-4 md:-mr-8 hidden md:flex items-center justify-end">
          <Image src={BocinaImage2} 
            alt="Megáfono Fundación Ciudadanía Inteligente" 
            class="w-48 md:w-[317px] h-auto mr-0"/>
        </div>
      </div>
    </div>

    <!-- franja newsletter -->
    <div class="md:mt-24 items-center bg-rosa mix-blend-screen shadow-md shadow-stone-400">
      <div class="py-5 px-5 md:py-20 md:px-32">
        <div class="text-white text-sm md:text-[28px] font-bold text-center">Súmate a nuestro newsletter de Ciudadanía Inteligente</div>
        <form action="//ciudadanointeligente.us5.list-manage.com/subscribe/post?u=73951bb4ca8d05cfc6a608807&id=b77280e172" method="post" class="py-2 font-['Mulish'] text-sm md:text-[18px] flex flex-col md:flex-row items-center gap-2" novalidate>
          <input 
            type="email"
            name="EMAIL"
            placeholder="Ingresa tu correo" 
            aria-label="Ingresa tu correo electrónico" 
            class="w-full md:w-[600px] py-1.5 px-3 bg-white border border-stone-300 caret-black rounded-md focus:outline-none focus:ring-2 focus:ring-white"
            required
          />
          <button 
            type="submit" 
            class="py-1.5 px-4 text-sm bg-rosa text-white border rounded-md hover:bg-white hover:text-rosa transition-colors duration-800 whitespace-nowrap"
          >
            Suscribirse
          </button>
        </form>
      </div>
    </div>

    <!-- título principal -->
    <div class="mt-30 text-base/6 items-center justify-center">
      <p class="font-bold text-center text-[32px] text-rosa">Escríbenos</p>
      <p class="font-normal text-center text-[22px] text-stone-800">¿Tienes dudas, propuestas o ideas para colaborar?</p>
      <p class="font-normal text-center text-[22px] text-stone-800">Escríbenos a <a href="mailto:info@ciudadaniai.org" class="font-bold text-azul">info@ciudadaniai.org</a></p> 
    </div>

    <!-- hero footer -->
    <div class="flex justify-center mb-4 mask-b-from-70%">
      <Image src={HeroContacto} 
        alt="Fundación Ciudadanía Inteligente" 
        class="image-fade-in transition ease-in-out duration-1000 delay-150" />
    </div>

  </main>
</Layout>
