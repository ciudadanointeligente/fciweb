---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import BocinaImage from '../assets/images/web/fci-megafono.png';
import HeroImage from '../assets/images/web/fci-hero-home.png';
import BocinaImage2 from '../assets/images/web/fci-megafono-2.png';
import Boton from '../components/Boton.astro';
---


<Layout title="Contacto">

  <!-- header -->
  <div class="bg-azul h-[150px] md:h-[300px] mix-blend-screen relative z-0 mt-[-30px] shadow-lg shadow-azul/45">
    <div class="text-center align-middle py-10 md:py-[120px]">
      <h1 class="text-2xl md:text-4xl text-white font-extrabold">Contacto</h1>
    </div>
  </div>

  <main>
    <!-- título principal -->
    <div class="mt-30 text-base/6 items-center justify-center">
      <p class="font-bold text-center text-[32px] text-rosa">¿Quieres sumarte, colaborar </p>
      <p class="font-bold text-center text-[32px] text-rosa">o escribirnos?</p> 
    </div>

    <!-- voluntariados y pasantías -->
    <div class="overflow-x-hidden">
      <div class="flex flex-row">
        <div class="w-1/3 -ml-8 flex items-center">
          <Image src={BocinaImage} 
            alt="Megáfono Fundación Ciudadanía Inteligente" 
            class="w-[317px] h-auto ml-0"/>
        </div>
        <div class="w-2/3 self-start flex flex-col items-center justify-center px-40 py-2">
          <p class="font-normal text-center text-[22px] text-stone-800">Aquí están las formas de tomar contacto con Ciudadanía Inteligente:</p> 
          <p class="font-bold text-center text-[22px] text-azul pt-4">VOLUNTARIADO Y PASANTÍAS</p>
          <p class="font-normal text-center text-[22px] text-stone-800">Se parte de nuestro equipo y aporta a la transformación democrática desde adentro</p>
          <p></p>
          <Boton href="mailto:info@ciudadaniai.org">POSTULA AQUÍ</Boton>
        </div>
        <div class="w-1/3 -mr-8 flex items-center justify-end">
          <Image src={BocinaImage2} 
            alt="Megáfono Fundación Ciudadanía Inteligente" 
            class="w-[317px] h-auto mr-0"/>
        </div>
      </div>
    </div>

    <!-- franja newsletter -->
    <div class="md:mt-24 items-center bg-rosa mix-blend-screen shadow-md shadow-stone-400">
      <div class="py-5 px-5 md:py-20 md:px-32">
        <div class="text-white text-sm md:text-[28px] font-bold">Súmate a nuestro newsletter de Ciudadanía Inteligente</div>
        <form class="py-2 font-['Mulish'] text-sm md:text-[18px]">
          <input 
            type="email" 
            placeholder="Ingresa tu correo" 
            aria-label="Ingresa tu correo electrónico" 
            class="md:w-[600px] py-1.5 px-1.5 bg-white border border-stone-300 caret-black rounded-md focus:outline-none focus:ring-2 focus:ring-white"
            required
          />
          <button 
            type="submit" 
            class="py-1.5 px-1.5 m-2 text-sm bg-rosa text-white border rounded-md hover:bg-white hover:text-rosa transition-colors duration-800"
          >
            Suscribirse
          </button>
        </form>
      </div>
    </div>

    <!-- título principal -->
    <div class="mt-30 text-base/6 items-center justify-center">
      <p class="font-bold text-center text-[32px] text-rosa">Escríbenos</p>
      <p class="font-normal text-center text-[22px] text-stone-800">¿Tienes dudas, propuestas o ideas para colaborar?</p>
      <p class="font-normal text-center text-[22px] text-stone-800">Escríbenos a <a href="mailto:info@ciudadaniai.org" class="font-bold text-azul">info@ciudadaniai.org</a></p> 
    </div>

    <!-- hero footer -->
    <div class="flex justify-center mt-20 mb-8 mask-b-from-90%">
      <Image src={HeroImage} 
        alt="Fundación Ciudadanía Inteligente" 
        class="w-full h-[800px]" />
    </div>

  </main>
</Layout>
