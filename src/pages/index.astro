---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BocinaImage from '../assets/images/web/fci-megafono.png';
import BocinaImage2 from '../assets/images/web/fci-megafono-2.png';
import HeroImage from '../assets/images/web/fci-home-1.webp';
import FooterImage from '../assets/images/web/fci-home-2.webp';
import GenteFondoImage from '../assets/images/web/fci-gente-home.png';
import Boton from '../components/Boton.astro';
import CardProyecto from '../components/CardProyecto.astro';
import SliderPublicaciones from '../components/SliderPublicaciones.astro';
import PublicacionCard from '../components/PublicacionCard.astro';

const allProjects = await getCollection('proyectos');
const homeProjects = allProjects.filter(project => project.data.home).sort((a, b) => a.data.order - b.data.order);

const allPosts = await getCollection('posts');
const homePosts = allPosts.filter(post => post.data.showOnHome).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
).map(post => ({
  image: post.data.imagepost || '', // Use imagepost or a default empty string
  title: post.data.title,
  description: post.data.subtitle || '', // Use subtitle or a default empty string
  link: `/posts/${post.slug}` // Assuming a default link structure for posts
}));

const allPublications = await getCollection('publicaciones');
const homePublications = allPublications.filter(pub => pub.data.showOnHome).slice(0, 3);

---


<Layout title="Inicio">

  <main>

    <!-- título principal -->
    <h1 class="text-sm mt-10 mb-2 text-pretty font-bold text-center md:leading-normal md:text-4xl md:pt-10">
      <div class="font-bold text-azul">Hacemos de la democracia</div> 
      <div class="font-bold text-rosa">UNA EXPERIENCIA COMPARTIDA,</div> 
      <div class="font-bold text-azul">justa y transformadora</div> 
    </h1>

    <!-- hero -->
    <div class="flex justify-center mb-4 mask-b-from-70%">
      <Image src={HeroImage} 
        alt="Fundación Ciudadanía Inteligente" 
        class="w-full h-[800px] image-fade-in grayscale-100 saturate-50 hover:grayscale-50 hover:saturate-50 transition ease-in-out duration-1000 delay-150"/>
    </div>

    <!-- visión y misión -->
    <div class="text-left px-10 md:flex md:pl-60 md:justify-center md:text-left">
      <div class="md:flex-1/2 text-pretty">
        <h2 class="text-azul text-[18px] font-semibold md:text-[32px] md:mt-10 md:mb-10">VISIÓN</h2>
        <div class="w-full text-[14px] text-pretty text-stone-900 md:max-w-4/5 md:text-[22px]">En Ciudadanía Inteligente impulsamos cambios colectivos para que la democracia en <strong>América Latina y el Caribe</strong> sea participativa, transparente, justa y cercana a las personas.</div>
      </div>
      <div class="mt-5 md:mt-0 md:flex-1/2 text-pretty">
        <h2 class="text-azul text-[18px] font-semibold md:text-[32px] md:mt-10 md:mb-10">MISIÓN</h2>
        <div class="w-full text-[14px] text-pretty text-stone-900 md:max-w-4/5 md:text-[22px]">Aspiramos a sociedades con ciudadanía organizada, instituciones responsables y decisiones políticas que pongan en el centro el <strong>bienestar de las personas y el planeta</strong>.</div>
      </div>
    </div>

    <!-- ver nosotros bocinas -->
    <div class="mt-10 overflow-x-hidden">
      <div class="flex flex-row">
        <div class="w-1/3 -ml-8 flex items-center">
          <Image src={BocinaImage} 
            alt="Megáfono Fundación Ciudadanía Inteligente" 
            class="w-[317px] h-auto ml-0 md:hover:animate-pulse"/>
        </div>
        <div class="w-2/3 flex items-center justify-center">
          <Boton href="/nosotros">VER NOSOTROS</Boton>
        </div>
        <div class="w-1/3 -mr-8 flex items-center justify-end">
          <Image src={BocinaImage2} 
            alt="Megáfono Fundación Ciudadanía Inteligente" 
            class="w-[317px] h-auto mr-0 md:hover:animate-pulse"/>
        </div>
      </div>
    </div>

    <!-- fondo gente -->
    <div class="place-self-center mb-18">
      <Image src={GenteFondoImage} 
        alt="Fondo gente Fundación Ciudadanía Inteligente" 
        class="w-[1080px] h-auto -mt-10 opacity-80"/>
    </div>

    <!-- cards de proyectos -->
    <h2 id="proyectos-heading" class="text-azul text-md md:text-[32px] font-bold text-center mb-10 mt-10">REVISA NUESTROS PROYECTOS</h2>
    <section aria-labelledby="proyectos-heading">
      <div class="flex flex-col w-auto items-center gap-4 md:flex-row md:flex-wrap md:justify-center">
        {
        homeProjects.map(project => (
        <CardProyecto 
          imagen={project.data.imagen} 
          alt={`Ciudadanía Inteligente - Proyecto ${project.data.nombre}`}
          nombre={project.data.nombre}
          descripcion={project.data.descripcion}
          link={project.data.link}
        />
        ))
        }
      </div>
    </section>

    <!-- botón ver más proyectos -->
    <div class="flex justify-center my-10 md:mb-20">
      <Boton href="/proyectos">VER MÁS</Boton>
    </div>

    <!-- ver noticias -->
    <h2 class="text-azul text-md md:text-[32px] font-bold text-center mb-10 md:pt-10">REVISA NUESTRAS ÚLTIMAS NOTICIAS</h2>
    <div class="mx-auto text-wrap"><SliderPublicaciones publications={homePosts} /></div>
    <!-- Botón Ver más noticias -->
    <div class="flex justify-center my-10 mb-20">
      <Boton href="/noticias">VER MÁS</Boton>
    </div>

    <!-- cards de publicaciones -->
    <h2 id="publicaciones-heading" class="text-azul text-md md:text-[32px] font-bold text-center mb-10 md:pt-10">NUESTRAS ÚLTIMAS PUBLICACIONES</h2>
    <section aria-labelledby="publicaciones-heading">
      <div class="flex flex-col w-auto items-center gap-4 md:flex-row md:flex-wrap md:justify-center">
        {
        homePublications.map(publication => (
        <PublicacionCard
          nombre={publication.data.nombre}
          descripcion={publication.data.descripcion || ''}
          imagen={publication.data.imagen || ''}
          link={publication.data.link}
          descarga={publication.data.descarga || ''}
        />
        ))
        }
      </div>
    </section>

    <!-- botón ver más publicaciones -->
    <div class="flex justify-center my-10 md:mb-20">
      <Boton href="/publicaciones">VER MÁS</Boton>
    </div>

    <!-- franja newsletter -->
    <div class="md:mt-24 items-center bg-rosa mix-blend-screen shadow-md shadow-stone-400">
      <div class="py-5 px-5 md:py-20 md:px-32">
        <div class="text-white text-sm md:text-[28px] font-bold">Súmate a nuestro newsletter de Ciudadanía Inteligente</div>
        <form action="//ciudadanointeligente.us5.list-manage.com/subscribe/post?u=73951bb4ca8d05cfc6a608807&id=b77280e172" method="post" class="py-2 font-['Mulish'] text-sm md:text-[18px]" novalidate>
          <input 
            type="email"
            name="EMAIL"
            placeholder="Ingresa tu correo" 
            aria-label="Ingresa tu correo electrónico" 
            class="md:w-[600px] py-1.5 px-1.5 bg-white border border-stone-300 caret-black rounded-md focus:outline-none focus:ring-2 focus:ring-white"
            required
          />
          <button 
            type="submit" 
            class="py-1.5 px-1.5 m-2 text-sm bg-rosa text-white border rounded-md hover:bg-white hover:text-rosa transition-colors duration-800"
          >
            Suscribirse
          </button>
        </form>
      </div>
    </div>

    <!-- hero footer -->
    <div class="flex justify-center mb-4 mask-b-from-70%">
      <Image src={FooterImage} 
        alt="Fundación Ciudadanía Inteligente" 
        class="w-full h-[800px] image-fade-in grayscale-100 saturate-50 hover:grayscale-50 hover:saturate-50 transition ease-in-out duration-1000 delay-150" />
    </div>

  </main>

</Layout>

