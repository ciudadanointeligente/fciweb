---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const categories = new Set<string>();
  posts.forEach(post => {
    if (post.data.category) {
      post.data.category.split(', ').forEach(cat => categories.add(cat.trim().toLowerCase().replace(/\s+/g, '-')));
    }
  });

  return Array.from(categories).map(category => ({
    params: { category: category },
  }));
}

const { category } = Astro.params;
const allPosts = await getCollection('posts');
const filteredPosts = allPosts.filter(post =>
  post.data.category && post.data.category.split(', ').map(cat => cat.trim().toLowerCase().replace(/\s+/g, '-')).includes(category)
);

const pageTitle = category.replace(/-/g, ' ').split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
---

<Layout title={`Noticias - ${pageTitle}`}>
  <div class="bg-azul h-[150px] md:h-[300px] mix-blend-screen relative z-0 mt-[-30px] shadow-lg shadow-azul/45">
    <div class="text-center align-middle py-10 md:py-[120px]">
      <h1 class="text-2xl md:text-4xl text-white font-extrabold">Noticias: {pageTitle}</h1>
    </div>
  </div>

  <main class="container mx-auto my-10 max-w-6xl">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 px-4">
      {filteredPosts.length > 0 ? (
        filteredPosts.map(post => (
          <a href={`/posts/${post.slug}`} class="block bg-white rounded-lg">
            {post.data.imagepost && (
              <Image
                src={post.data.imagepost}
                alt={post.data.title}
                width={600}
                height={400}
                class="w-full h-auto object-cover rounded-lg"
              />
            )}
            <div class="p-4">
              <h2 class="text-xl font-bold text-stone-900 mb-2">{post.data.title}</h2>
              <p class="text-stone-600 text-sm">{post.data.subtitle}</p>
              <div class="mt-2 text-sm text-stone-500">
                <div class="mb-4"><span>Por {post.data.author}</span></div>
                {post.data.category && (
                  <span>
                    {post.data.category.split(', ').map(cat => {
                      const categorySlug = cat.trim().toLowerCase().replace(/\s+/g, '-');
                      return <a href={`/categorias/${categorySlug}`} class="bg-stone-200 px-2 py-0.5 rounded-full text-xs hover:bg-stone-300">{cat.trim()}</a>;
                    })}
                  </span>
                )}
              </div>
            </div>
          </a>
        ))
      ) : (
        <p class="col-span-full text-center text-stone-600">No hay noticias en esta categoría.</p>
      )}
    </div>
  </main>
</Layout>
