---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import CardProyecto from '../../../components/CardProyecto.astro';
import { Image } from 'astro:assets';
import FCINosotrosImg from '../../../assets/images/web/fci-nosotros-img3.png';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  const categories = new Set<string>();
  proyectos.forEach(proyecto => {
    if (proyecto.data.ubicacion) {
      (Array.isArray(proyecto.data.ubicacion) ? proyecto.data.ubicacion : [proyecto.data.ubicacion]).forEach(cat => categories.add(cat.trim().toLowerCase().replace(/\s+/g, '-')));
    }
  });

  return Array.from(categories).map(category => ({
    params: { category: category },
  }));
}

const { category } = Astro.params;
const allProyectos = await getCollection('proyectos');
const filteredProyectos = allProyectos.filter(proyecto =>
  proyecto.data.ubicacion && (Array.isArray(proyecto.data.ubicacion) ? proyecto.data.ubicacion : [proyecto.data.ubicacion]).map(cat => cat.trim().toLowerCase().replace(/\s+/g, '-')).includes(category)
);

const pageTitle = category.replace(/-/g, ' ').split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
---

<Layout title={`Proyectos - ${pageTitle}`}>
  <div class="bg-azul h-[150px] md:h-[300px] mix-blend-screen relative z-0 mt-[-30px] shadow-lg shadow-azul/45">
    <div class="text-center align-middle py-10 md:py-[120px]">
      <h1 class="text-2xl md:text-4xl text-white font-extrabold">Proyectos: {pageTitle}</h1>
    </div>
  </div>

  <main class="mx-auto text-center md:py-8 w-10/12 p-4 md:px-8 md:mt-12">
    <section aria-labelledby="proyectos-heading">
      {filteredProyectos.length > 0 ? (
        filteredProyectos.map(proyecto => (
          <CardProyecto 
            imagen={proyecto.data.imagen} 
            alt={proyecto.data.nombre}
            nombre={proyecto.data.nombre}
            descripcion={proyecto.data.descripcion}
            link={proyecto.data.link}
            ubicacion={proyecto.data.ubicacion}
            status={proyecto.data.status}
          />
        ))
      ) : (
        <p class="col-span-full text-center text-stone-600">No hay proyectos en esta categoría.</p>
      )}
    </section>
    <div class="flex justify-center md:justify-start w-full mt-2 md:mt-2">
      <Image src={FCINosotrosImg} alt="Fundación Ciudadanía Inteligente" class="w-[150px] h-auto -rotate-2 md:w-[300px]" />
    </div>
  </main>
</Layout>