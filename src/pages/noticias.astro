---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import LogoFCI from '../assets/images/logos/fci_logo_navbar.png';
const posts = await getCollection('posts');
---


<Layout title="Noticias">
    <main>
        <h1 class="text-3xl font-bold text-center mt-10 mb-6 text-azul">Noticias</h1>
        <div class="text-center mt-10 mb-6 text-black"><ul>
      {
        posts.map(post => (
          <li>
            <a href={`/posts/${post.slug}`}>{post.data.title}</a>
          </li>
        ))
      }
    </ul></div>
    </main>
</Layout>
