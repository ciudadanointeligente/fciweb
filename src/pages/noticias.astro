---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import LogoFCI from '../assets/images/logos/fci_logo_navbar.png';
import HeroImage from '../assets/images/web/fci-hero-home.png';
import FCINosotrosImg from '../assets/images/web/fci-nosotros-img3.png';

const posts = await getCollection('posts');
const noticias = posts.map(post => ({
  title: post.data.title,
  subtitle: post.data.subtitle,
  image: post.data.imagepost || '',
  category: post.data.category,
  author: post.data.author
}));

---


<Layout title="Noticias">

  <!-- header -->
  <div class="bg-azul h-[150px] md:h-[300px] mix-blend-screen relative z-0 mt-[-30px] shadow-lg shadow-azul/45">
    <div class="text-center align-middle py-10 md:py-[120px]">
      <h1 class="text-2xl md:text-4xl text-white font-extrabold">Noticias</h1>
    </div>
  </div>

<!-- loop noticias -->
  <main class="container mx-auto my-10 max-w-6xl">
    <div class="grid grid-cols-1 md:grid-cols-2 md:gap-12 gap-1 px-4 py-1">
      {posts.map(post => (
      <a href={`/posts/${post.slug}`} class="block bg-white rounded-lg">
        {post.data.imagepost && (
        <Image 
          src={post.data.imagepost} 
          alt={post.data.title} 
          width={600} 
          height={400} 
          class="w-full h-auto object-cover rounded-lg"
        />
        )}
        <div class="py-1 md:p-4">
          <h2 class="text-xl font-bold text-stone-900 mb-2">{post.data.title}</h2>
          <p class="text-stone-600 text-sm">{post.data.subtitle}</p>
          <div class="mt-2 mb-6 text-sm text-stone-500">
            <div class="mb-4"><span>Por {post.data.author}</span></div>
            {post.data.category && (
            <span>
              {post.data.category.split(', ').map(cat => {
              const categorySlug = cat.trim().toLowerCase().replace(/\s+/g, '-');
              return <a href={`/categorias/${categorySlug}`} class="bg-stone-200 px-2 py-0.5 rounded-full text-xs hover:bg-stone-300">{cat.trim()}</a>;
              })}
            </span>
            )}
          </div>
        </div>
      </a>
      ))}
    </div>
  </main>

  <!-- franja newsletter -->
  <div class="md:mt-24 items-center bg-rosa mix-blend-screen shadow-md shadow-stone-400">
    <div class="py-5 px-5 md:py-20 md:px-32">
      <div class="text-white text-sm md:text-[28px] font-bold">Súmate a nuestro newsletter de Ciudadanía Inteligente</div>
      <form class="py-2 font-['Mulish'] text-sm md:text-[18px]">
        <input 
          type="email" 
          placeholder="Ingresa tu correo" 
          aria-label="Ingresa tu correo electrónico" 
          class="md:w-[600px] py-1.5 px-1.5 bg-white border border-stone-300 caret-black rounded-md focus:outline-none focus:ring-2 focus:ring-white"
          required
        />
        <button 
          type="submit" 
          class="py-1.5 px-1.5 m-2 text-sm bg-rosa text-white border rounded-md hover:bg-white hover:text-rosa transition-colors duration-800"
        >
          Suscribirse
        </button>
      </form>
    </div>
  </div>

  <!-- hero footer -->
  <div class="flex justify-center mb-8 mask-b-from-90%">
    <Image src={HeroImage} 
      alt="Fundación Ciudadanía Inteligente" 
      class="w-full h-[800px]" />
  </div>

</Layout>
