---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import CardProyecto from '../components/CardProyecto.astro';
import { Image } from 'astro:assets';
import HeroImage from '../assets/images/web/fci-proyectos.webp';
import FCINosotrosImg from '../assets/images/web/fci-nosotros-img3.png';

const allProyectos = (await getCollection('proyectos')).sort((a, b) => a.data.order - b.data.order);
---


<Layout title="Proyectos">

  <!-- header -->
  <div class="bg-azul h-[150px] md:h-[300px] mix-blend-screen relative z-0 mt-[-30px] shadow-lg shadow-azul/45">
    <div class="text-center align-middle py-10 md:py-[120px]">
      <h1 class="text-2xl md:text-4xl text-white font-extrabold">Proyectos</h1>
    </div>
  </div>

  <main class="mx-auto text-center md:py-8 w-10/12 p-4 md:px-8 md:mt-12">

    <section aria-labelledby="proyectos-heading">
      {
      allProyectos.map((proyecto) => (
      <CardProyecto 
        imagen={proyecto.data.imagen} 
        alt={proyecto.data.nombre}
        nombre={proyecto.data.nombre}
        descripcion={proyecto.data.descripcion}
        link={proyecto.data.link}
        status={proyecto.data.status}
      />
      ))
      }
    </section>

  </main>

    <!-- franja newsletter -->
    <div class="md:mt-24 items-center bg-rosa mix-blend-screen shadow-md shadow-stone-400">
      <div class="py-5 px-5 md:py-20 md:px-32">
        <div class="text-white text-sm md:text-[28px] font-bold">Súmate a nuestro newsletter de Ciudadanía Inteligente</div>
        <form action="//ciudadanointeligente.us5.list-manage.com/subscribe/post?u=73951bb4ca8d05cfc6a608807&id=b77280e172" method="post" class="py-2 font-['Mulish'] text-sm md:text-[18px]" novalidate>
          <input 
            type="email"
            name="EMAIL"
            placeholder="Ingresa tu correo" 
            aria-label="Ingresa tu correo electrónico" 
            class="md:w-[600px] py-1.5 px-1.5 bg-white border border-stone-300 caret-black rounded-md focus:outline-none focus:ring-2 focus:ring-white"
            required
          />
          <button 
            type="submit" 
            class="py-1.5 px-1.5 m-2 text-sm bg-rosa text-white border rounded-md hover:bg-white hover:text-rosa transition-colors duration-800"
          >
            Suscribirse
          </button>
        </form>
      </div>
    </div>

  <!-- hero footer -->
  <div class="flex justify-center md:mt-20 mb-8 mask-b-from-70%">
    <Image src={HeroImage} 
      alt="Fundación Ciudadanía Inteligente" 
      class="w-full h-[800px] image-fade-in grayscale-100 saturate-50 hover:grayscale-50 hover:saturate-50 transition ease-in-out duration-1000 delay-150" />
  </div>
</Layout>

