---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import CardProyecto from '../components/CardProyecto.astro';
import { Image } from 'astro:assets';

const allProyectos = await getCollection('proyectos');

const uniqueUbicaciones = [...new Set(allProyectos.map(proyecto => proyecto.data.ubicacion))];
const uniqueStatus = [...new Set(allProyectos.map(proyecto => proyecto.data.status))];
---


<Layout title="Proyectos">
  <main class="mx-auto py-8 w-full px-8">
    <h1 class="text-3xl font-bold text-center mt-10 mb-6 text-azul">Nuestros Proyectos</h1>

    <div class="flex flex-col md:flex-row justify-center gap-4 mb-8">
      <div class="w-full md:w-1/4">
        <label for="ubicacion-filter" class="block text-sm font-medium text-gray-700">Filtrar por Ubicación:</label>
        <select id="ubicacion-filter" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-azul focus:border-azul sm:text-sm rounded-md" client:load>
          <option value="all">Todas</option>
          {
            uniqueUbicaciones.map(ubicacion => (
              <option value={ubicacion}>{ubicacion}</option>
            ))
          }
        </select>
      </div>

      <div class="w-full md:w-1/4">
        <label for="status-filter" class="block text-sm font-medium text-gray-700">Filtrar por Estado:</label>
        <select id="status-filter" class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-azul focus:border-azul sm:text-sm rounded-md" client:load>
          <option value="all">Todos</option>
          {
            uniqueStatus.map(status => (
              <option value={status}>{status}</option>
            ))
          }
        </select>
      </div>
    </div>

    <section aria-labelledby="proyectos-heading">
        {
          allProyectos.map(proyecto => (
            <CardProyecto 
              imgSrc={proyecto.data.imagen} 
              alt={proyecto.data.nombre}
              title={proyecto.data.nombre}
              description={proyecto.data.descripcion}
              projectUrl={proyecto.data.link}
              data-ubicacion={proyecto.data.ubicacion}
              data-status={proyecto.data.status}
            />
          ))
        }
    </section>
  </main>
</Layout>

<!-- filtro -->
<script is:inline>
  const proyectosGrid = document.getElementById('proyectos-grid');
  const ubicacionFilter = document.getElementById('ubicacion-filter');
  const statusFilter = document.getElementById('status-filter');

  function filterProjects() {
    const selectedUbicacion = ubicacionFilter.value;
    const selectedStatus = statusFilter.value;

    console.log('Selected Ubicación:', selectedUbicacion);
    console.log('Selected Status:', selectedStatus);

    Array.from(proyectosGrid.children).forEach(card => {
      const ubicacion = card.dataset.ubicacion;
      const status = card.dataset.status;

      console.log('Card Ubicación:', ubicacion, 'Card Status:', status);

      const matchesUbicacion = selectedUbicacion === 'all' || ubicacion === selectedUbicacion;
      const matchesStatus = selectedStatus === 'all' || status === selectedStatus;

      if (matchesUbicacion && matchesStatus) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }

  ubicacionFilter.addEventListener('change', filterProjects);
  statusFilter.addEventListener('change', filterProjects);

  // filtro inicial
  filterProjects();
</script>
