---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

const { slug } = Astro.params;
if (!slug) throw new Error('Slug not found');
const post = await getEntry('posts', slug);

if (!post) throw new Error('No post found for this slug');
const { Content } = await post.render();

const categoryNames = post.data.category ? post.data.category.split(', ') : [];
const categoriesHtml = categoryNames.length > 0 ? 
  `<span>
    ${categoryNames.map(name => {
      const categorySlug = name.trim().toLowerCase().replace(/\s+/g, '-');
      return `<a href="/categorias/${categorySlug}" class="ml-1 bg-stone-200 px-2 py-0.5 rounded-full text-xs hover:bg-stone-300">${name}</a>`;
    }).join('')}
  </span>` : '';

// Generate static pages
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug }
  }));
}
---


<Layout title={post.data.title}>
  <article class="container mx-auto px-4 my-10 max-w-4xl bg-white/70">
    <nav class="text-sm text-stone-500 mb-4" aria-label="Breadcrumb">
      <ol class="list-none p-0 inline-flex">
        <li class="flex items-center">
          <a href="/noticias" class="text-blue-600 hover:underline">Noticias</a>
          <svg class="fill-current w-3 h-3 mx-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path d="M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 71.256c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568 0 33.941z"/></svg>
        </li>
        <li>
          <span class="text-stone-700">{post.data.title.length > 50 ? post.data.title.substring(0, 50) + '...' : post.data.title}</span>
        </li>
      </ol>
    </nav>
    {post.data.imagepost && (
      <div class="mb-8">
        <Image 
          src={post.data.imagepost} 
          alt={post.data.title} 
          width={1200} 
          height={600} 
          class="w-full h-auto object-cover rounded-lg shadow-md"
        />
      </div>
    )}

    <h1 class="text-4xl md:text-5xl font-extrabold text-stone-900 mb-4 leading-tight">{post.data.title}</h1>
    {post.data.subtitle && <p class="text-xl md:text-2xl text-stone-600 mb-6 leading-relaxed">{post.data.subtitle}</p>}

    <div class="flex items-center text-sm text-stone-500 mb-8">
      {post.data.author && <span class="mr-4">Por {post.data.author}</span>}
      <Fragment set:html={categoriesHtml} />
    </div>

    <div class="font-['Mulish'] prose prose-lg max-w-none text-stone-800 leading-relaxed space-y-12">
      <Content />
    </div>
  </article>
</Layout>
