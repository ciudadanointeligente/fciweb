---
interface Publication {
  image: string;
  title: string;
  description: string;
  link: string;
}

interface Props {
  publications: Publication[];
}

const { publications } = Astro.props;
---


<!-- slider de noticias -->
<div class="relative w-full mx-auto" id="slider-container" role="region" aria-roledescription="carousel">
  <div class="text-pretty relative h-64 md:h-[300px] overflow-hidden rounded-lg">
    <!-- slider container -->
    <div
      class="text-pretty flex w-full md:w-full justify-center items-center h-full"
      x-data="sliderData"
      data-publications={JSON.stringify(publications)}
      x-init="init()"
    >
      <template x-for="(publication, index) in publications" :key="index">
        <div
          class="text-pretty absolute w-[90%] md:w-[700px] h-64 md:h-[300px] transition-all duration-500 ease-in-out transform rounded-lg overflow-hidden top-0 left-1/2 cursor-pointer"
          @click="activeSlide = index"
          x-show="Math.abs(activeSlide - index) <= 1 || (activeSlide === 0 && index === publications.length - 1) || (activeSlide === publications.length - 1 && index === 0)"
          :class="{
            'opacity-100 z-10 scale-100': activeSlide === index,
            'opacity-50 z-0 scale-90 blur-sm': (Math.abs(activeSlide - index) === 1) || (activeSlide === 0 && index === publications.length - 1) || (activeSlide === publications.length - 1 && index === 0),
            'pointer-events-none': !(Math.abs(activeSlide - index) <= 1 || (activeSlide === 0 && index === publications.length - 1) || (activeSlide === publications.length - 1 && index === 0))
          }"
          :style="{
            transform: activeSlide === index ? 'translateX(-50%)' : (index === (activeSlide - 1 + publications.length) % publications.length) ? 'translateX(calc(-50% - 50%))': (index === (activeSlide + 1) % publications.length) ? 'translateX(calc(-50% + 50%))': 'translateX(-50%)'
          }"
          :aria-live="activeSlide === index ? 'polite' : 'off'"
          :aria-hidden="activeSlide !== index"
        >
          <div class="text-pretty relative bg-white rounded-lg w-full h-full overflow-hidden">
            <template x-if="activeSlide === index">
              <a :href="publication.link" class="absolute inset-0 w-full h-full text-decoration-none">
                <img :src="publication.image" :alt="publication.title" class="w-full h-full object-cover" @click.stop />
                <div class="absolute bottom-0 left-0 right-0 bg-black/90 bg-opacity-50 text-white text-wrap p-2 h-1/4 flex flex-col items-center-safe">
                  <div class="text-xs md:text-base text-wrap font-['Mulish'] font-normal" x-text="publication.title"></div>
                </div>
              </a>
            </template>
            <template x-if="activeSlide !== index">
              <img :src="publication.image" :alt="publication.title" class="w-full h-full object-cover" />
              <div class="absolute bottom-0 left-0 right-0 bg-black/90 bg-opacity-50 text-white text-wrap p-2 h-1/4 flex flex-col items-center-safe">
                <div class="text-xs md:text-base text-wrap font-['Mulish'] font-normal" x-text="publication.title"></div>
              </div>
            </template>
          </div>
        </div>
      </template>
    </div>
  </div>
</div>

<script is:inline>
document.addEventListener('alpine:init', () => {
  if (window.Alpine) {
    window.Alpine.data('sliderData', () => ({
      activeSlide: 0,
      publications: [],
      init() {
        const dataElement = this.$el;
        if (dataElement && dataElement.dataset.publications) {
          this.publications = JSON.parse(dataElement.dataset.publications);
        }
      }
    }));
  }
});
</script>
