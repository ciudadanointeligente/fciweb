---
interface Publication {
  image: string;
  title: string;
  description: string;
}

interface Props {
  publications: Publication[];
}

const { publications } = Astro.props;
---

<div class="relative w-full mx-auto" id="slider-container">
  <div class="relative h-60 overflow-hidden rounded-lg">
    <!-- Slider container -->
    <div
      class="flex md:w-full justify-center items-center h-full"
      x-data="sliderData"
      data-publications={JSON.stringify(publications)}
    >
      <template x-for="(publication, index) in publications" :key="index">
          <div
            class="absolute w-[700px] h-[300px] transition-all duration-500 ease-in-out transform rounded-lg overflow-hidden top-0 left-1/2"
            x-show="Math.abs(activeSlide - index) <= 1 || (activeSlide === 0 && index === publications.length - 1) || (activeSlide === publications.length - 1 && index === 0)"
            :class="{
              'opacity-100 z-10 scale-100': activeSlide === index,
              'opacity-50 z-0 scale-90 blur-sm': (Math.abs(activeSlide - index) === 1) || (activeSlide === 0 && index === publications.length - 1) || (activeSlide === publications.length - 1 && index === 0),
              'pointer-events-none': !(Math.abs(activeSlide - index) <= 1 || (activeSlide === 0 && index === publications.length - 1) || (activeSlide === publications.length - 1 && index === 0))
            }"
            :style="{
              transform: activeSlide === index ? 'translateX(-50%)' : (index === (activeSlide - 1 + publications.length) % publications.length) ? 'translateX(calc(-50% - 400px))': (index === (activeSlide + 1) % publications.length) ? 'translateX(calc(-50% + 400px))': 'translateX(-50%)'
            }"
            x-transition:enter="transition ease-out duration-1000"
            x-transition:enter-start="opacity-0"
            x-transition:enter-end="opacity-100"
            x-transition:leave="transition ease-in duration-1000"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
          >
            <div class="relative bg-white shadow-lg rounded-lg w-full h-full overflow-hidden">
              <img :src="publication.image" :alt="publication.title" class="absolute inset-0 w-full h-full object-cover cursor-pointer" @click="activeSlide = (index + 1) % publications.length">
            <div class="absolute bottom-0 left-0 right-0 bg-black/90 bg-opacity-50 text-white p-4 h-1/4 flex flex-col justify-center">
              <div class="text-md font-['Mulish'] font-light m-0" x-text="publication.title"></div>
              <div class="text-xs font-['Mulish'] m-0" x-text="publication.description"></div>
            </div>
            </div>
          </div>
      </template>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('alpine:init', () => {
    if (window.Alpine) {
      window.Alpine.data('sliderData', () => ({
        activeSlide: 0,
        publications: [],
        init() {
          const dataElement = this.$el;
          if (dataElement && dataElement.dataset.publications) {
            this.publications = JSON.parse(dataElement.dataset.publications);
          }
          console.log('Alpine data initialized. Publications:', this.publications);
        }
      }));
    } else {
      console.error('Alpine.js not found on window.Alpine');
    }
  });
</script>
