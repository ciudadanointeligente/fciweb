---
interface Props {
  classes?: string;
}

const { classes = 'shadow-md shadow-stone-400' } = Astro.props;
---

<div class={`md:mt-24 bg-rosa mix-blend-screen ${classes}`}>
  <div class="py-5 px-5 md:py-20 md:px-32">
    <div class="text-white text-sm md:text-[28px] font-bold">Súmate a nuestro newsletter de Ciudadanía Inteligente</div>
    <form action="//ciudadanointeligente.us5.list-manage.com/subscribe/post?u=73951bb4ca8d05cfc6a608807&id=b77280e172" method="post" class="py-2 font-['Mulish'] text-sm md:text-[18px] flex flex-col md:flex-row gap-2" novalidate>
      <input
        type="email"
        name="EMAIL"
        placeholder="Ingresa tu correo"
        aria-label="Ingresa tu correo electrónico"
        class="w-full md:w-[600px] py-1.5 px-3 bg-white border border-stone-300 caret-black rounded-md focus:outline-none focus:ring-2 focus:ring-white"
        required
      />
      <button
        type="submit"
        class="py-1.5 px-4 text-sm bg-rosa text-white border rounded-md hover:bg-white hover:text-rosa transition-colors duration-800 whitespace-nowrap"
      >
        Suscribirse
      </button>
    </form>
  </div>
</div>
