---
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets';
import Lealtad from '../assets/images/logos/lealtad.png';
---


<!-- footer global -->
<footer>
  <div class="w-full bg-black mix-blend-screen mt-0 border-t-4 border-stone-200">
    <div class="flex justify-center mb-2">
      <h2 class="text-stone-200 text-sm md:text-2xl font-bold">Ciudadanía_Inteligente</h2>
    </div>
    <div class="flex flex-row justify-center">
      <div>
        <a href="https://www.facebook.com/ciudadaniai/"><Icon name="mdi:facebook" class="w-6 h-6 mx-2 text-white hover:text-stone-400" aria-label="Facebook de Ciudadanía Inteligente"/></a>
      </div>
      <div>
        <a href="https://twitter.com/ciudadania_i"><Icon name="mdi:twitter" class="w-6 h-6 mx-2 text-white hover:text-stone-400" aria-label="Twitter de Ciudadanía Inteligente"/></a>
      </div>
      <div>
        <a href="https://www.youtube.com/channel/UCtiq34lXdXDxo6GhIwnY5Sw"><Icon name="mdi:youtube" class="w-6 h-6 mx-2 text-white hover:text-stone-400" aria-label="YouTube de Ciudadanía Inteligente"/></a>
      </div>
      <div>
        <a href="https://www.instagram.com/ciudadaniai/"><Icon name="mdi:instagram" class="w-6 h-6 mx-2 text-white hover:text-stone-400" aria-label="Instagram de Ciudadanía Inteligente"/></a>
      </div>
      <div>
        <a href="https://github.com/ciudadanointeligente"><Icon name="mdi:github" class="w-6 h-6 mx-2 text-white hover:text-stone-400" aria-label="GitHub de Ciudadanía Inteligente"/></a>
      </div>
      <div>
        <a href="https://gitlab.com/ciudadaniai"><Icon name="mdi:gitlab" class="w-6 h-6 mx-2 text-white hover:text-stone-400" aria-label="GitLab de Ciudadanía Inteligente"/></a>
      </div>
      <!-- <div> -->
      <!--   <Image src={CCImage} alt="Creative Commons" class="w-8 h-8 mx-2 invert"/> -->
      <!-- </div> -->
    </div>
    <div class="flex flex-row justify-center mt-5">
      <a href="https://ciudadaniai.org/assets/attachments/estandar-de-transparencia-y-buenas-practicas-fci.pdf">
        <Image src={Lealtad} alt="Lealtad" target="_blank" class="w-22 h-auto"/>
      </a>
    </div>

    <!-- footer menú -->
    <div class="text-center mt-5 mb-2 align-bottom text-stone-200 text-xs font-[Mulish]">

      <a href="/" aria-label="link inicio" data-astro-reload class="px-2 text-sm">Inicio</a>
      <a href="/nosotros" aria-label="link nosotros" class="px-2 text-sm">Nosotros</a>
      <a href="/proyectos" aria-label="link proyectos" class="px-2 text-sm">Proyectos</a>
      <a href="/publicaciones" aria-label="link publicaciones" class="px-2 text-sm">Publicaciones</a>
      <a href="/noticias" aria-label="link noticias" class="px-2 text-sm">Noticias</a>
      <a href="/transparencia" aria-label="link informes" class="px-2 text-sm">Transparencia</a>
      <a href="/contacto" aria-label="link contacto" class="px-2 text-sm">Contacto</a>

    </div>
    <hr class="h-0.1 border border-stone-600 bg-stone-900" />
    <div class="text-center align-bottom text-stone-200 text-xs p-2">
      &copy; {new Date().getFullYear()} Fundación Ciudadanía Inteligente. Todos los derechos reservados.
    </div>
  </div>
</footer>
