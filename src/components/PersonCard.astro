---
import { Image, getImage } from 'astro:assets';

interface Props {
  name: string;
  position: string;
  photo: string;
  description: string;
  email?: string;
  twitter?: string;
  linkedin?: string;
  instagram?: string;
  github?: string;
}

const { name, position, photo: photoPath, description, email, twitter, linkedin, instagram, github } = Astro.props;

const optimizedPhoto = await getImage({
  src: photoPath,
  width: 192, // 192px
  height: 192, // 192px
});
---


<!-- card de persona -->
<div class="w-80 h-[360px] relative mx-auto my-4 transition-transform duration-300 hover:translate-y-5.5">
  <Image
    src={optimizedPhoto.src}
    alt={`Foto de ${name}`}
    width={optimizedPhoto.options.width}
    height={optimizedPhoto.options.height}
    class="absolute top-[-48px] left-1/2 -translate-x-1/2 rounded-full w-38 h-38 object-cover shadow-[0px_6px_10px_4px_rgba(0,0,0,0.15)] z-10"
  />
  <div class="absolute left-0 w-full px-2.5 pt-12 pb-4 top-[100px] bg-white rounded-[30px] shadow-[0px_6px_10px_4px_rgba(0,0,0,0.15)] flex flex-col justify-start items-center gap-2.5 overflow-hidden">
    <div class="flex-1 text-center">
      <div class="text-rosa text-[24px]/6  font-normal font-['Space_Mono']">{name}<br/></div>
      <div class="text-stone-900 text-[20px]/6 font-medium font-['Mulish']">{position}</div>
    </div>
    <!-- <div class="text-stone-600 text-sm leading-snug text-center px-4"> -->
    <!--   <Fragment set:html={description} /> -->
    <!-- </div> -->
    <div class="flex justify-center gap-2 mt-2">
      <!-- { -->
      <!--   email && ( -->
      <!--   <a href={`mailto:${email}`} class="btn btn-circle btn-xs bg-white text-rosa/40"> -->
      <!--       <i class="fa-solid fa-envelope"></i> -->
      <!--     </a> -->
      <!--   ) -->
      <!-- } -->
      <!-- { -->
      <!--   twitter && ( -->
      <!--     <a href={twitter} target="_blank" rel="noopener noreferrer" class="btn btn-circle btn-xs bg-white text-rosa/40"> -->
      <!--       <i class="fa-brands fa-twitter"></i> -->
      <!--     </a> -->
      <!--   ) -->
      <!-- } -->
      <!-- { -->
      <!--   linkedin && ( -->
      <!--     <a href={linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-circle btn-xs bg-white text-rosa/40"> -->
      <!--       <i class="fa-brands fa-linkedin"></i> -->
      <!--     </a> -->
      <!--   ) -->
      <!-- } -->
      <!-- { -->
      <!--   instagram && ( -->
      <!--     <a href={instagram} target="_blank" rel="noopener noreferrer" class="btn btn-circle btn-xs bg-white text-rosa/40"> -->
      <!--       <i class="fa-brands fa-instagram"></i> -->
      <!--     </a> -->
      <!--   ) -->
      <!-- } -->
      <!-- { -->
      <!--   github && ( -->
      <!--     <a href={github} target="_blank" rel="noopener noreferrer" class="btn btn-circle btn-xs bg-white text-rosa/40"> -->
      <!--       <i class="fa-brands fa-github"></i> -->
      <!--     </a> -->
      <!--   ) -->
      <!-- } -->
      <button
        class="btn btn-circle btn-xs bg-white text-rosa/40"
        onclick={`document.getElementById('person-modal-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}').showModal()`}
      >
        <i class="fa-solid fa-circle-info"></i>
      </button>
    </div>
  </div>
</div>

<!-- modal de persona -->
<dialog id={`person-modal-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`} class="modal">
  <div class="modal-box w-4/12 max-w-5xl p-0 bg-white rounded-2xl shadow-lg">
    <form method="dialog">
      <button class="btn btn-xs btn-circle btn-ghost text-rosa bg-rosa/10 absolute right-2 top-2">✕</button>
    </form>
    <div class="flex flex-col md:flex-row">
      <div class="md:w-1/3 bg-gray-200 flex">
        <Image
          src={optimizedPhoto.src}
          alt={`Foto de ${name}`}
          width={optimizedPhoto.options.width * 4}
          height={optimizedPhoto.options.height * 4}
          class="object-cover"
        />
      </div>
      <div class="md:w-2/3 py-4 px-4">
        <div class="font-normal text-[22px] leading-6 text-azul font-['Space_Mono']">{name}</div>
        <p class="text-stone-900 text-[16px] leading-4 font-medium font-['Mulish']">{position}</p>
        <p class="text-stone-600 text-[16px] leading-4 font-medium font-['Mulish']">
          {description} 
        </p>
        <div class="flex flex-wrap gap-2 mt-4">
          {
          email && (
          <a href={`mailto:${email}`} class="btn btn-circle btn-xs bg-white text-rosa/40">
            <i class="fa-solid fa-envelope"></i>
          </a>
          )
          }
          {
          twitter && (
          <a href={twitter} target="_blank" rel="noopener noreferrer" class="btn btn-circle btn-xs bg-white text-rosa/40">
            <i class="fa-brands fa-twitter"></i> 
          </a>
          )
          }
          {
          linkedin && (
          <a href={linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-circle btn-xs bg-white text-rosa/40">
            <i class="fa-brands fa-linkedin"></i> 
          </a>
          )
          }
          {
          instagram && (
          <a href={instagram} target="_blank" rel="noopener noreferrer" class="btn btn-circle btn-xs bg-white text-rosa/40">
            <i class="fa-brands fa-instagram"></i> 
          </a>
          )
          }
          {
          github && (
          <a href={github} target="_blank" rel="noopener noreferrer" class="btn btn-circle btn-xs bg-white text-rosa/40">
            <i class="fa-brands fa-github"></i> 
          </a>
          )
          }
        </div>
      </div>
    </div>
  </div>
</dialog>
