---
import { Image } from 'astro:assets';
const { nombre, imagen, descripcion, link, descarga } = Astro.props;
---


<!-- cards de proyectos -->
<div class="flex flex-col w-full max-w-[394px] mb-2 md:h-[550px] md:inline-flex justify-start items-start md:gap-2 md:mr-4 p-[17px_8px_17px_10px] md:shrink-0 rounded-md bg-white shadow-md shadow-gray-400">
  <div class="w-full place-content-stretch overflow-hidden rounded-md mt-1">
    <Image src={imagen} alt={nombre} class="md:h-[295px] w-full object-cover image-fade-in" />
  </div>
  <div class="w-full px-2 font-['Space Mono'] font-normal text-[28px] text-left">{nombre}</div>
  <p class="px-2 py-auto text-[14px] text-pretty font-normal font-['Mulish']">{descripcion}</p>
  <div class="self-end mt-auto">
    <a href="/" target="_blank" rel="noopener noreferrer" aria-label="IR A PROYECTO (se abre en una nueva pestaña)" 
      class="flex items-center px-3 py-0.5 bg-azul text-[12px] text-white font-['Mulish'] font-light rounded-lg shadow-gray-400 shadow-md transition-colors duration-300 hover:bg-rosa md:mr-2 md:text-[18px] no-underline">
      IR A PROYECTO
    </a>
  </div>
</div>
<div class="card bg-base-100 w-96 shadow-sm">
  <figure class="px-10 pt-10">
    <img
      src="https://img.daisyui.com/images/stock/photo-1606107557195-0e29a4b5b4aa.webp"
      alt="Shoes"
      class="rounded-xl" />
  </figure>
  <div class="card-body items-center text-center">
    <h2 class="card-title">Card Title</h2>
    <p>A card component has a figure, a body part, and inside body there are title and actions parts</p>
    <div class="card-actions">
      <button class="btn btn-primary">Buy Now</button>
    </div>
  </div>
</div>

