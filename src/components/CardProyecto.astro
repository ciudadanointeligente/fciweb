---
const { nombre, descripcion, imagen, link } = Astro.props;
---


<!-- cards de proyectos -->
<div class="flex flex-col w-full max-w-[394px] mb-2 md:h-[550px] md:inline-flex justify-start items-start gap-2 md:mr-8 p-4 md:p-[17px_8px_17px_10px] md:shrink-0 rounded-md bg-white shadow-md shadow-stone-400">
  <div class="w-full place-content-stretch overflow-hidden rounded-md">
    <img src={imagen} alt={descripcion} class="h-48 md:h-[295px] w-full object-cover image-fade-in" />
  </div>
  <div class="w-full px-2 font-['Space Mono'] font-normal text-xl md:text-[28px] text-left">{nombre}</div>
  <p class="px-2 py-auto text-sm md:text-[18px] text-left text-pretty font-normal font-['Mulish']">{descripcion}</p>
  <div class="self-end mt-auto">
    <a href={link} target="_blank" rel="noopener noreferrer" aria-label="IR A PROYECTO (se abre en una nueva pestaña)" 
      class="flex items-center px-3 py-0.5 bg-azul text-[12px] text-white font-['Mulish'] font-light rounded-lg shadow-stone-400 shadow-md transition-colors duration-300 hover:bg-rosa md:mr-2 md:text-[18px] no-underline">
      IR A PROYECTO
    </a>
  </div>
</div>

