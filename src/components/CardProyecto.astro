---
const { imgSrc, title, description, projectUrl } = Astro.props;
---

<div class="flex flex-col md:w-[394px] md:h-[589px] md:inline-flex justify-start items-start md:gap-1.5 p-[17px_8px_17px_10px] md:shrink-0 rounded-md bg-white shadow-md shadow-gray-400">
  <div class="w-full place-content-stretch shadow-md shadow-gray-400 overflow-hidden rounded-md mt-1.5">
    <img src={imgSrc} alt={title} class="h-[295px] w-full object-cover" />
  </div>
  <div class="w-full px-2 font-['Space Mono'] font-normal text-[28px] text-left">{title}</div>
  <p class="px-2 py-auto text-[14px] font-normal font-['Mulish']">{description}</p>
  <div class="self-end mt-auto">
    <a href={projectUrl} target="_blank" rel="noopener noreferrer"
      class="flex items-center px-2 py-0.5 bg-azul text-[12px] text-white font-['Mulish'] font-medium rounded-lg shadow-gray-400 shadow-md transition-colors duration-300 hover:bg-rosa md:text-[16px] no-underline">
      IR A PROYECTO
    </a>
  </div>
</div>

