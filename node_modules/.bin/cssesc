#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/media/felipe/felipe/Devs/keys/node_modules/cssesc/bin/node_modules:/media/felipe/felipe/Devs/keys/node_modules/cssesc/node_modules:/media/felipe/felipe/Devs/keys/node_modules:/media/felipe/felipe/Devs/node_modules:/media/felipe/felipe/node_modules:/media/felipe/node_modules:/media/node_modules:/node_modules:/media/felipe/felipe/Devs/keys/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/media/felipe/felipe/Devs/keys/node_modules/cssesc/bin/node_modules:/media/felipe/felipe/Devs/keys/node_modules/cssesc/node_modules:/media/felipe/felipe/Devs/keys/node_modules:/media/felipe/felipe/Devs/node_modules:/media/felipe/felipe/node_modules:/media/felipe/node_modules:/media/node_modules:/node_modules:/media/felipe/felipe/Devs/keys/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../cssesc/bin/cssesc" "$@"
else
  exec node  "$basedir/../cssesc/bin/cssesc" "$@"
fi
